# Neuromancer, in the colours of the Apple TV series: electric blue and indigo, petrol teal in the shadows, a pink neon key light,
# cool silver text on a blue-black. Same roles as gits.theme.
name = Neuromancer
description = The sky above the port was the color of television, tuned to a dead channel. Jack in.
wallpaper = neuromancer_chiba.jpg
art = neuromancer

# the lock screen: cyberspace at night, a turning ICE instead of the Tachikoma, Chiba instead of Section 9
lock_bg = neuromancer_lock_bg.jpg
mascot = ice
swap = 公安9課  //  SECTION 9 -> 千葉シティ  //  CHIBA CITY
swap = echo "LINK: $( -> echo "JACKED IN: $(

bg            = #08090E
bg_deep       = #040509
surface       = #10142A
surface_deep  = #0B0E1C
fg            = #D8E2F0
fg_gtk        = #DEE7F3
fg_bright     = #EEF3FA
muted         = #9CB0CC
dim           = #26324A
dim_text      = #5A6780

accent        = #3D7BFF
accent_bright = #9FC6FF
accent_2      = #FF3D8B

red           = #FF3355
red_light     = #FF7896
green         = #13A5B5
green_light   = #7FE0E8
yellow        = #FFB347
yellow_light  = #FFD699
blue          = #3D5BFF
blue_light    = #8FA2FF
violet        = #7A4DFF
violet_light  = #B39BFF
