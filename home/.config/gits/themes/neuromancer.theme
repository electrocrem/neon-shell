# Neuromancer, the Apple TV series' colours in pastel: periwinkle blue, soft pink, sea-glass teal and lavender on a dusty indigo
# night, cool silver text. Same roles as gits.theme.
name = Neuromancer
description = The sky above the port was the color of television, tuned to a dead channel. Jack in.
wallpaper = neuromancer_chiba.jpg
art = neuromancer

# the lock screen: cyberspace at night, a turning ICE instead of the Tachikoma, Chiba instead of Section 9
lock_bg = neuromancer_lock_bg.jpg
mascot = ice
swap = 公安9課  //  SECTION 9 -> 千葉シティ  //  CHIBA CITY
swap = echo "LINK: $( -> echo "JACKED IN: $(

bg            = #0E1018
bg_deep       = #090A10
surface       = #1A1E30
surface_deep  = #141726
fg            = #E6ECF7
fg_gtk        = #EAEFF8
fg_bright     = #F5F7FC
muted         = #AEB9D2
dim           = #343C57
dim_text      = #6C7593

accent        = #8FA8FF
accent_bright = #C9D5FF
accent_2      = #FFA8CF

red           = #FF8A9E
red_light     = #FFB8C4
green         = #86D9D0
green_light   = #BDEDE7
yellow        = #FFD49A
yellow_light  = #FFE7C4
blue          = #8FA2F0
blue_light    = #C1CCFA
violet        = #B9A3F5
violet_light  = #DCD0FB
